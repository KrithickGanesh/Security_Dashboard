# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/devsecops_dashboard

# ---------------------------------------------------------------
# Authentication
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------
JWT_SECRET=replace_with_a_random_64_char_hex_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ---------------------------------------------------------------
# Frontend origin(s)
# Comma-separated. Local dev uses http://localhost:5173.
# Production example: https://your-app.vercel.app
# ---------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------
# Cookies and proxies
# COOKIE_SAME_SITE: strict | lax | none
#   - strict/lax  -> SPA and API share an origin (nginx, same server)
#   - none        -> SPA and API are on different sites (Vercel + Render)
# COOKIE_SECURE: true | false. Defaults to true when NODE_ENV=production.
# TRUST_PROXY: number of proxy hops in front of Express (1 for nginx/Render).
# ---------------------------------------------------------------
COOKIE_SAME_SITE=
COOKIE_SECURE=
TRUST_PROXY=1

# ---------------------------------------------------------------
# Email (optional - logs a warning and skips sending when unset)
# ---------------------------------------------------------------
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@devsecops-dashboard.local
