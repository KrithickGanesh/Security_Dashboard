# ---------------------------------------------------------------
# Client build-time configuration (Vite)
# Copy to .env.local for a production build.
#
# Leave VITE_API_URL empty in development: the Vite dev server proxies
# /api and /socket.io to http://localhost:5000.
# ---------------------------------------------------------------

# Absolute URL of the deployed API, no trailing slash, no /api suffix.
# Example: https://devsecops-api.onrender.com
VITE_API_URL=

# Optional. Defaults to VITE_API_URL when empty.
# Example: https://devsecops-api.onrender.com
VITE_SOCKET_URL=
